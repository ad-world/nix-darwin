export NIX_DARWIN_FLAKE="$PWD#macbook"

mkdir -p .direnv/bin

cat > .direnv/bin/apply-darwin <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
sudo darwin-rebuild switch --flake "${NIX_DARWIN_FLAKE:-$PWD#macbook}"
EOF

cat > .direnv/bin/check-darwin <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
nix flake check --no-build
EOF

chmod +x .direnv/bin/apply-darwin .direnv/bin/check-darwin
PATH_add .direnv/bin

if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "nix-darwin has local changes."
  echo "Run: apply-darwin"
fi
